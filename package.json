{
    "name":  "openclaw-panel",
    "version":  "0.1.0",
    "description":  "Windows desktop shell for the OpenClaw web control panel.",
    "main":  "src/main.js",
    "private":  true,
    "scripts":  {
                    "start":  "electron .",
                    "pack":  "electron-builder --dir",
                    "dist":  "electron-builder --win portable"
                },
    "devDependencies":  {
                            "electron":  "^33.4.11",
                            "electron-builder":  "^25.1.8",
                            "png-to-ico":  "^3.0.1",
                            "sharp":  "^0.34.5"
                        },
    "build":  {
                  "appId":  "ai.openclaw.panel",
                  "productName":  "OpenClaw Panel",
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "files":  [
                                "src/**/*",
                                "package.json"
                            ],
                  "win":  {
                              "target":  [
                                             "portable"
                                         ],
                              "icon":  "build/icon.ico"
                          },
                  "portable":  {
                                   "artifactName":  "OpenClaw-Panel-${version}.exe"
                               },
                  "extraResources":  [
                                         {
                                             "to":  "icon.ico",
                                             "from":  "build/icon.ico"
                                         }
                                     ]
              }
}
